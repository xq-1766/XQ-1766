# OpenAI 兼容协议 LLM 配置模版
# 请复制此文件并重命名为 .env，然后填写实际参数

# LLM 服务的 API 基础地址 (例如: http://localhost:1234/v1 或 https://api.openai.com/v1)
LLM_BASE_URL=http://localhost:1234/v1

# 使用的模型名称 (例如: qwen2.5-7b-instruct 或 gpt-3.5-turbo)
LLM_MODEL=local-model

# API 访问令牌 (本地模型通常可填 "no-key" 或任意字符串)
LLM_API_KEY=your_api_key_here

ANYTHINGLLM_API_KEY=your_api_key_here
ANYTHINGLLM_WORKSPACE_SLUG=your_workspace_slug_here